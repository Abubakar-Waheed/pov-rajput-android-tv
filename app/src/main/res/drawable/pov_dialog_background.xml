<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog card: a soft vertical gradient with a hairline border, shared by every dialog in the app. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#FF2A2A30" android:endColor="#FF17171A" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="#2EFFFFFF" />
</shape>
