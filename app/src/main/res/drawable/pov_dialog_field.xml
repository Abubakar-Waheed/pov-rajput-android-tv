<?xml version="1.0" encoding="utf-8"?>
<!-- Text fields: a rounded box inset from the dialog edges, outlined in white while focused. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="24dp" android:insetRight="24dp" android:insetTop="6dp" android:insetBottom="6dp">
    <selector>
        <item android:state_focused="true">
            <shape android:shape="rectangle">
                <solid android:color="#24FFFFFF" /><stroke android:width="2dp" android:color="#FFFFFFFF" /><corners android:radius="12dp" />
                <padding android:left="16dp" android:right="16dp" android:top="12dp" android:bottom="12dp" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="#16FFFFFF" /><stroke android:width="1dp" android:color="#3DFFFFFF" /><corners android:radius="12dp" />
                <padding android:left="16dp" android:right="16dp" android:top="12dp" android:bottom="12dp" />
            </shape>
        </item>
    </selector>
</inset>
