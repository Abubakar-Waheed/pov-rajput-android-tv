<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog actions: translucent pills that turn solid white when the remote focuses them. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /><corners android:radius="10dp" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="#DDFFFFFF" /><corners android:radius="10dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#24FFFFFF" /><corners android:radius="10dp" /></shape></item>
</selector>
