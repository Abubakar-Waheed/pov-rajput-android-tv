<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#65E2ED</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#141414</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Every AlertDialog in the app uses the designed dialog below instead of the stock look. -->
        <item name="android:alertDialogTheme">@style/PovDialog</item>
        <!-- Dialog inputs are built with the activity context, so the field style is set here too. -->
        <item name="android:editTextStyle">@style/PovDialogField</item>
    </style>

    <style name="PovDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/pov_dialog_background</item>
        <item name="android:backgroundDimAmount">0.82</item>
        <item name="android:windowMinWidthMajor">48%</item>
        <item name="android:windowMinWidthMinor">70%</item>
        <item name="android:colorAccent">#E50914</item>
        <item name="android:colorControlActivated">#E50914</item>
        <item name="android:colorControlNormal">#99FFFFFF</item>
        <item name="android:colorControlHighlight">#33FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#FFC4C4C8</item>
        <item name="android:textColorAlertDialogListItem">#FFFFFFFF</item>
        <item name="android:windowTitleStyle">@style/PovDialogTitle</item>
        <item name="android:buttonBarStyle">@style/PovDialogButtonBar</item>
        <item name="android:buttonBarButtonStyle">@style/PovDialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/PovDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/PovDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/PovDialogButton</item>
        <item name="android:listViewStyle">@style/PovDialogList</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/pov_dialog_item</item>
        <item name="android:editTextStyle">@style/PovDialogField</item>
    </style>

    <style name="PovDialogTitle">
        <item name="android:textAppearance">@style/PovDialogTitleText</item>
    </style>
    <style name="PovDialogTitleText" parent="android:TextAppearance.Material.DialogWindowTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PovDialogButtonBar" parent="android:Widget.Material.ButtonBar.AlertDialog">
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">18dp</item>
    </style>

    <style name="PovDialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/pov_dialog_button</item>
        <item name="android:textColor">@color/pov_dialog_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minWidth">112dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="PovDialogList" parent="android:Widget.Material.ListView">
        <item name="android:listSelector">@drawable/pov_dialog_item</item>
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:drawSelectorOnTop">false</item>
    </style>

    <style name="PovDialogField" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/pov_dialog_field</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textColorHint">#FF8E8E93</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
